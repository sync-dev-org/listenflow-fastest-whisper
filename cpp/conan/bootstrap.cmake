# The same dependency installation serves the standalone and Python entry points.
include_guard(GLOBAL)

function(lffw_install_conan profile output offline)
    get_filename_component(cpp "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    if(EXISTS "${cpp}/../pyproject.toml")
        set(pyproject "${cpp}/../pyproject.toml")
    else()
        set(pyproject "${cpp}/../python/pyproject.toml")
    endif()
    file(READ "${pyproject}" metadata)
    if(NOT metadata MATCHES "\"conan==([0-9]+\\.[0-9]+\\.[0-9]+)\"")
        message(FATAL_ERROR "Pin the Conan CLI as conan==X.Y.Z in ${pyproject}")
    endif()
    set(version "${CMAKE_MATCH_1}")
    set(installation "uv tool install \"conan==${version}\"")
    find_program(LFFW_CONAN_EXECUTABLE conan)
    if(NOT LFFW_CONAN_EXECUTABLE)
        message(FATAL_ERROR "Conan ${version} is required. Run: ${installation}")
    endif()
    execute_process(COMMAND "${LFFW_CONAN_EXECUTABLE}" --version
        RESULT_VARIABLE status OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0 OR NOT actual STREQUAL "Conan version ${version}")
        message(FATAL_ERROR "Expected Conan ${version}, found '${actual}'. Run: ${installation}")
    endif()

    file(READ "${cpp}/conan.lock" lock)
    set(references)
    set(missing)
    foreach(context IN ITEMS requires build_requires)
        string(JSON count LENGTH "${lock}" ${context})
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE ${last})
                string(JSON reference GET "${lock}" ${context} ${index})
                string(REGEX REPLACE "%.*$" "" reference "${reference}")
                if(NOT reference MATCHES "^[^/]+/[^#]+#[0-9a-f]+$")
                    message(FATAL_ERROR "The dependency ${reference} in ${cpp}/conan.lock lacks a locked revision")
                endif()
                list(APPEND references "${reference}")
                execute_process(COMMAND "${LFFW_CONAN_EXECUTABLE}" cache path "${reference}"
                    RESULT_VARIABLE cached OUTPUT_QUIET ERROR_QUIET)
                if(NOT cached EQUAL 0)
                    list(APPEND missing "${reference}")
                endif()
            endforeach()
        endif()
    endforeach()
    file(MAKE_DIRECTORY "${output}")
    set(release "$ENV{LFFW_RELEASE_BUILD}")
    if(release OR (NOT offline AND missing))
        if(release)
            set(archive "${cpp}/conan/recipes.tar.gz")
            if(NOT EXISTS "${archive}")
                message(FATAL_ERROR "Release source archive lacks ${archive}")
            endif()
            set(export_references "${references}")
        else()
            set(download "${output}/recipe-download")
            file(MAKE_DIRECTORY "${download}")
            configure_file("${cpp}/conan/fetch_recipe.py" "${download}/conanfile.py" COPYONLY)
            configure_file("${cpp}/conan/recipe-archive.json" "${download}/recipe-archive.json" COPYONLY)
            execute_process(COMMAND "${LFFW_CONAN_EXECUTABLE}" source "${download}" -vwarning
                RESULT_VARIABLE status OUTPUT_VARIABLE fetched ERROR_VARIABLE diagnostic)
            if(NOT status EQUAL 0)
                message(FATAL_ERROR "Cannot fetch the locked native SDK recipes:\n${fetched}\n${diagnostic}")
            endif()
            set(archive "${download}/recipes.tar.gz")
            set(export_references "${missing}")
        endif()
        file(READ "${cpp}/conan/recipe-archive.json" receipt)
        string(JSON expected_sha256 GET "${receipt}" sha256)
        file(SHA256 "${archive}" actual_sha256)
        if(NOT actual_sha256 STREQUAL expected_sha256)
            message(FATAL_ERROR "Recipe archive checksum mismatch: ${archive}")
        endif()
        file(WRITE "${output}/recipe-archive.sha256" "${actual_sha256}  recipes.tar.gz\n")
        set(recipes "${output}/recipes")
        file(MAKE_DIRECTORY "${recipes}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${recipes}")
        foreach(reference IN LISTS export_references)
            string(REGEX MATCH "^([^/]+)/([^#]+)#" unused "${reference}")
            set(recipe_name "${CMAKE_MATCH_1}")
            set(recipe_version "${CMAKE_MATCH_2}")
            set(recipe "${recipes}/recipes/${recipe_name}")
            if(NOT EXISTS "${recipe}/conanfile.py")
                message(FATAL_ERROR "The recipe archive does not contain ${recipe_name}")
            endif()
            execute_process(COMMAND "${LFFW_CONAN_EXECUTABLE}" export "${recipe}"
                --version "${recipe_version}" --format=json
                RESULT_VARIABLE status OUTPUT_VARIABLE exported ERROR_VARIABLE diagnostic)
            if(NOT status EQUAL 0)
                message(FATAL_ERROR "Cannot export ${reference}: ${diagnostic}")
            endif()
            string(JSON actual GET "${exported}" reference)
            file(WRITE "${output}/recipe-${recipe_name}.json" "${exported}\n")
            if(NOT actual STREQUAL reference)
                message(FATAL_ERROR "Exported ${actual}, but the lock requires ${reference}")
            endif()
        endforeach()
        file(REMOVE_RECURSE "${recipes}")
        if(NOT release)
            file(REMOVE_RECURSE "${download}")
        endif()
    endif()

    if(release)
        set(build --build=*)
    elseif(offline)
        set(build --build=never)
    else()
        set(build --build=missing)
    endif()
    execute_process(COMMAND "${LFFW_CONAN_EXECUTABLE}" install "${cpp}"
        "--profile:host=${profile}" "--profile:build=${profile}"
        "--lockfile=${cpp}/conan.lock" "--output-folder=${output}" --no-remote "${build}"
        RESULT_VARIABLE status OUTPUT_VARIABLE installed ERROR_VARIABLE diagnostic)
    file(WRITE "${output}/install.log" "${installed}\n${diagnostic}")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Conan dependency installation failed:\n${installed}\n${diagnostic}\n"
            "Prepare the locked dependencies: cmake -P ${cpp}/conan/prepare-tests.cmake\n"
            "Selected profile: ${profile}; Conan uses its default package storage.")
    endif()
    message(STATUS "Conan native dependencies: ${references}")
endfunction()

# prepare-tests.cmake invokes the installer explicitly in script mode.
if(CMAKE_SCRIPT_MODE_FILE)
    return()
endif()
if(NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
    return()
endif()
set(lffw_toolchain "${CMAKE_BINARY_DIR}/conan/conan_toolchain.cmake")
if(CMAKE_TOOLCHAIN_FILE)
    get_filename_component(lffw_existing_toolchain "${CMAKE_TOOLCHAIN_FILE}" ABSOLUTE
        BASE_DIR "${CMAKE_BINARY_DIR}")
    if(NOT lffw_existing_toolchain STREQUAL lffw_toolchain)
        return()
    endif()
endif()
if(DEFINED ENV{LFFW_RELEASE_BUILD} AND NOT "$ENV{LFFW_RELEASE_BUILD}" STREQUAL "0"
        AND NOT "$ENV{LFFW_RELEASE_BUILD}" STREQUAL "")
    set(lffw_default_profile "${CMAKE_CURRENT_LIST_DIR}/profiles/manylinux-gcc-toolset-14")
else()
    set(lffw_default_profile "${CMAKE_CURRENT_LIST_DIR}/profiles/linux-gcc-toolset-15")
endif()
set(LFFW_CONAN_PROFILE "${lffw_default_profile}"
    CACHE FILEPATH "Conan host and build profile")
option(LFFW_CONAN_OFFLINE "Use only dependencies prepared by cpp/conan/prepare-tests.cmake" OFF)
set(lffw_offline "${LFFW_CONAN_OFFLINE}")
if(NOT DEFINED BUILD_TESTING OR BUILD_TESTING)
    set(lffw_offline TRUE)
endif()
lffw_install_conan("${LFFW_CONAN_PROFILE}" "${CMAKE_BINARY_DIR}/conan" "${lffw_offline}")
set(CMAKE_TOOLCHAIN_FILE "${lffw_toolchain}" CACHE FILEPATH "Conan generated toolchain" FORCE)
get_property(lffw_multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(NOT lffw_multi_config AND NOT CMAKE_BUILD_TYPE)
    file(READ "${CMAKE_BINARY_DIR}/conan/CMakePresets.json" lffw_presets)
    string(JSON lffw_build_type GET "${lffw_presets}" configurePresets 0 cacheVariables CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE "${lffw_build_type}" CACHE STRING "Build type" FORCE)
endif()
