# SP-LFFASTESTWHISPER-055: link the supplied toolkit's static runtime without a shared cudart dependency.
cmake_minimum_required(VERSION 3.26)
execute_process(COMMAND "${READELF}" --dynamic "${LIBRARY}"
    RESULT_VARIABLE status OUTPUT_VARIABLE dynamic ERROR_VARIABLE diagnostic)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect CUDA runtime dependencies: ${diagnostic}")
endif()
if(dynamic MATCHES "\\(NEEDED\\)[^\n]*\\[libcudart\\.so[^]]*\\]")
    message(FATAL_ERROR "${LIBRARY} depends on the shared CUDA runtime")
endif()
file(STRINGS "${LINK_MAP}" archives REGEX "^LOAD .*libcudart_static\\.a$")
if(NOT archives)
    message(FATAL_ERROR "The link inputs for ${LIBRARY} do not contain libcudart_static.a")
endif()
file(REAL_PATH "${TOOLKIT_ROOT}" toolkit)
foreach(entry IN LISTS archives)
    string(REGEX REPLACE "^LOAD " "" archive "${entry}")
    file(REAL_PATH "${archive}" archive)
    cmake_path(IS_PREFIX toolkit "${archive}" NORMALIZE from_toolkit)
    if(NOT from_toolkit)
        message(FATAL_ERROR "The static CUDA runtime is outside the supplied toolkit: ${archive}")
    endif()
endforeach()
